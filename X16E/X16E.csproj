<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>icon\icon.ico</ApplicationIcon>
    <PackageProjectUrl>https://github.com/Yazwh0/BitMagic</PackageProjectUrl>
    <PackageIcon>butterfly.jpg</PackageIcon>
  </PropertyGroup>

  <!--
    Published as a .NET tool, one package per RID like X16M (`dotnet tool install` picks
    BitMagic.X16E.win-x64 or .linux-x64), so each only carries its own platform's Silk.NET
    natives. The managed code is platform neutral; the emulator core and ZiModem host are
    picked up via BitMagic.X16Emulator.csproj, so CI stages both platforms' native builds
    before running `dotnet pack` (see build-test.yml's "nuget-publish" job).
  -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>x16e</ToolCommandName>
    <PackageId>BitMagic.X16E</PackageId>
    <Title>X16E</Title>
    <Description>BitMagic's Commander X16 emulator.</Description>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Shipped next to the exe, the fetch-rom option runs the one for the current platform. -->
  <ItemGroup>
    <None Update="fetch-rom.bat" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fetch-rom.sh" CopyToOutputDirectory="PreserveNewest" />
    <None Update="check-prerequisites.sh" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="GL\**" />
    <EmbeddedResource Remove="GL\**" />
    <None Remove="GL\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="icon\butterfly.jpg" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="icon\icon.ico" />
  </ItemGroup>

  <ItemGroup>
  <ProjectReference Include="..\..\BitMagic.Libraries\BitMagic.Common\BitMagic.Common.csproj" />
  <ProjectReference Include="..\..\BitMagic.X16Compiler\BitMagic.Compiler\BitMagic.Compiler.csproj" />
  <ProjectReference Include="..\..\BitMagic.X16Compiler\BitMagic.Decompiler\BitMagic.Decompiler.csproj" />
  <ProjectReference Include="..\BitMagic.X16Emulator.Display\BitMagic.X16Emulator.Display.csproj" />
  <ProjectReference Include="..\BitMagic.X16Emulator.Serializer\BitMagic.X16Emulator.Serializer.csproj" />
  <ProjectReference Include="..\BitMagic.X16Emulator\BitMagic.X16Emulator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="icon\butterfly.jpg">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="EmulatorCore\EmulatorCore.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ProjectExtensions><VisualStudio><UserProperties properties_4launchsettings_1json__JsonSchema="https://json.schemastore.org/minecraft-dimension-type.json" /></VisualStudio></ProjectExtensions>

</Project>
