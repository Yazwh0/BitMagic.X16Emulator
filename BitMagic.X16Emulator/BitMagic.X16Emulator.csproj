<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableUnmanagedDebugging>true</EnableUnmanagedDebugging>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="state_object.xlsx" />
    <None Remove="~%24state_object.xlsx" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Content Include="..\X16Emulator\EmulatorCore\x64\$(Configuration)\EmulatorCore.dll" Link="EmulatorCore.dll">
      <CopyToOutput>true</CopyToOutput>
      <PackageFlatten>false</PackageFlatten>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
  </ItemGroup>
  
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Content Include="..\X16Emulator\EmulatorCore\x64\$(Configuration)\EmulatorCore.so" Link="EmulatorCore.so">
      <CopyToOutput>true</CopyToOutput>
      <PackageFlatten>false</PackageFlatten>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
  </ItemGroup>

  <!-- ZiModem host C ABI lib. Single-config Ninja build => one fixed output dir, not $(Configuration)-qualified. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Content Include="..\..\External\BitMagic.ZiModem\build\native\bin\zimodem_host.dll" Link="zimodem_host.dll">
      <CopyToOutput>true</CopyToOutput>
      <PackageFlatten>false</PackageFlatten>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Content Include="..\..\External\BitMagic.ZiModem\build\native\bin\libzimodem_host.so" Link="libzimodem_host.so">
      <CopyToOutput>true</CopyToOutput>
      <PackageFlatten>false</PackageFlatten>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BitMagic.Libraries\BitMagic.Common\BitMagic.Common.csproj" />
    <ProjectReference Include="..\..\External\DiscUtils\Library\DiscUtils.Core\BitMagic.DiscUtils.Core.csproj" />
    <ProjectReference Include="..\..\External\DiscUtils\Library\DiscUtils.Vdi\BitMagic.DiscUtils.Vdi.csproj" />
    <ProjectReference Include="..\..\External\DiscUtils\Library\DiscUtils.Vhd\BitMagic.DiscUtils.Vhd.csproj" />
    <ProjectReference Include="..\..\External\DiscUtils\Library\DiscUtils.Fat\BitMagic.DiscUtils.Fat.csproj" />
  </ItemGroup>

  <ItemGroup Condition=" '$(Configuration)' != 'Release' ">
    <ProjectReference Include="..\X16Emulator\EmulatorCore\EmulatorCore.vcxproj" />
    <!-- Build-order only: runs the ZiModem CMake/Ninja build so the zimodem_host.dll picked up
         by the <Content> item above exists. Not linked, not copied (Content handles the copy).
         Gated out of Release like EmulatorCore.vcxproj so `dotnet build -c Release` stays clean;
         Release builds ZiModemHost.vcxproj separately (see CLAUDE.md). -->
    <ProjectReference Include="..\..\External\BitMagic.ZiModem\native\ZiModemHost.vcxproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="none"
                      Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="Silk.NET.Input" Version="2.22.0" />
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>OS_WINDOWS</DefineConstants>
  </PropertyGroup>
  
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <DefineConstants>OS_LINUX</DefineConstants>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>False</Optimize>
  </PropertyGroup>

</Project>